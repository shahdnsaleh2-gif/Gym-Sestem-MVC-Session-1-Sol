@model MemberViewModel
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white text-center py-4 bg-danger">
                    <i class="bi bi-exclamation-triangle display-4 mb-2"></i>
                    <h3 class="mb-0">Delete Member?</h3>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] is not null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle me-1"></i>
                        This action is permanent — no undo.
                    </div>

                    <ul class="list-unstyled">
                        <li><strong>Email:</strong> @Model.Email</li>
                        <li><strong>Phone:</strong> @Model.Phone</li>
                    </ul>
                </div>
                <div class="card-footer bg-white border-0 p-4 d-flex gap-2">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex-fill">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline flex-fill">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>
