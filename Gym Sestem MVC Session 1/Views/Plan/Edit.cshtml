@model PlanToUpdateViewModel
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-primary-color mb-4">Edit Plan</h2>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="alert alert-light border">
                    <i class="bi bi-lock me-1"></i>
                    Plan name <strong>"@Model.Name"</strong> cannot be changed.
                </div>

                <div class="mb-3">
                    <label asp-for="Duration" class="form-label">Duration (days)</label>
                    <input asp-for="Duration" class="form-control" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price (EGP)</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary-color">
                        <i class="bi bi-check-circle me-1"></i>Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
