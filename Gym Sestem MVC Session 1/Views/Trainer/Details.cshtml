@model TrainerViewModel
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white text-center py-5 bg-primary-color">
                    <i class="bi bi-person-badge display-4 mb-3"></i>
                    <h2 class="mb-0">@Model.Name</h2>
                    <span class="badge bg-light text-dark mt-2">@Model.Specialty</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <h6 class="text-muted mb-0"><i class="bi bi-envelope me-1"></i>Email</h6>
                            <p class="fw-bold">@Model.Email</p>
                        </div>
                        <div class="col-6">
                            <h6 class="text-muted mb-0"><i class="bi bi-telephone me-1"></i>Phone</h6>
                            <p class="fw-bold">@Model.Phone</p>
                        </div>
                        <div class="col-6">
                            <h6 class="text-muted mb-0"><i class="bi bi-gender-ambiguous me-1"></i>Gender</h6>
                            <p class="fw-bold">@Model.Gender</p>
                        </div>
                        <div class="col-6">
                            <h6 class="text-muted mb-0"><i class="bi bi-calendar me-1"></i>Date Of Birth</h6>
                            <p class="fw-bold">@Model.DateOfBirth</p>
                        </div>
                        <div class="col-12">
                            <h6 class="text-muted mb-0"><i class="bi bi-house me-1"></i>Address</h6>
                            <p class="fw-bold">@Model.Address</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-4">
                    <a asp-action="Index" class="btn btn-outline">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>